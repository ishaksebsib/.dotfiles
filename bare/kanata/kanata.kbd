;; Dual-function keys on macOS, like interception-tools dual-function-keys on
;; NixOS (hosts/nixos/services.nix): tap for the key, hold for a modifier.
;; Option is the OmniWM mod key, so Space-hold gives Option (SUPER on NixOS).
;; Caps-hold gives Command, the Mac's app-shortcut key (Ctrl on NixOS).
;; Caps/Escape are swapped here too, instead of with hidutil.
;;
;; Top row: kanata has to take the whole keyboard and re-send it through the
;; Karabiner virtual keyboard, which loses the brightness/media keys that
;; Apple's driver makes from the MacBook's plain F1-F12. So the row is mapped
;; back to what's printed on it, like Karabiner-Elements does by default
;; (kanata #975/#1141).

(defcfg
  ;; tap-hold-release needs to see keys that are not in defsrc
  process-unmapped-keys yes
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  caps spc
)

(defalias
  ;; 200ms tap/hold, same as TAP_MILLISEC on NixOS. Hold only wins once another
  ;; key is pressed *and released* inside the hold, so fast typing that rolls
  ;; over Space or Caps stays plain text
  cap (tap-hold-release 200 200 esc lmet)
  spc (tap-hold-release 200 200 spc lalt)
)

(deflayer base
  caps brdn brup mctl sls  dtn  dnd  prev pp   next mute vold volu
  @cap @spc
)
